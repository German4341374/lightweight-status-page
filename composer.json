{
  "name": "portfolio/lightweight-status-page",
  "description": "A compact public service status page with manually managed incidents.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-pdo": "*",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15.2",
    "slim/twig-view": "^3.4.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "cs-check": "php-cs-fixer check --diff --verbose",
    "cs-fix": "php-cs-fixer fix",
    "lint": [
      "@cs-check",
      "@analyse"
    ],
    "verify": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
